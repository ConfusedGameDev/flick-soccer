{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./index.ts", "./room.ts", "../src/engine/**/*.ts", "../src/net/**/*.ts", "../src/render/kits.ts"],
  "exclude": ["../src/engine/*.test.ts"]
}
